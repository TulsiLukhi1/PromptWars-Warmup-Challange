# Build stage
FROM node:20-alpine as build
WORKDIR /app
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

# Production stage
FROM nginx:alpine
# Copy built assets from build stage
COPY --from=build /app/dist /usr/share/nginx/html
# Expose port 80 (Cloud Run default)
EXPOSE 80
# Start Nginx server
CMD ["nginx", "-g", "daemon off;"]
